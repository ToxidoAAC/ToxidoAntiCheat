DISCORD_TOKEN=
GUILD_ID=
NOW_CATEGORY_ID=
LOG_CATEGORY_ID=
# En az biri dolu olmali: STAFF_ROLE_ID veya STAFF_USER_ID
STAFF_ROLE_ID=
STAFF_USER_ID=

API_KEY=dev-key
API_SECRET=dev-secret-change-me

DB_PATH=./data/toxido.db
DOWNLOAD_PATH=./static/40x1d0AC.exe
HOST=127.0.0.1
PORT=8000
DRY_RUN=1
HEARTBEAT_TIMEOUT_SECONDS=120

# Discord enjeksiyon uyarilari. Modlu istemcilerdeki sinif/path yanlis
# pozitiflerini kanala gondermemek icin varsayilan filtre yuksek guvendir.
INJECTION_ALERTS=1
INJECTION_ALERT_KINDS=jvm_argument,mod_file,cheat_signature,external_agent
INJECTION_MIN_CONFIDENCE=high
